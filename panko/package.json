{
  "name": "panko",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Panko – a chat assistant on top of Claude that reads your data, builds reports and remembers past conversations",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "dompurify": "^3.4.18",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.75.0",
    "marked": "^18.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
